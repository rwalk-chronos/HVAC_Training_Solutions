---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const active = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#071522" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-value-bar" aria-label="Course highlights">
      <span>HVAC fundamentals that make sense</span>
      <span aria-hidden="true">•</span>
      <span>Real instructor support</span>
      <span aria-hidden="true">•</span>
      <span>30-day satisfaction promise</span>
    </div>

    <div class="site-header-wrap">
      <header class="site-header">
        <a class="brand" href="/" aria-label="HVAC Training Solutions home">
          <img src="/images/hvac-training-solutions-logo.png" width="250" height="63" alt="HVAC Training Solutions" />
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a class:list={["nav-link", { active: active("/") }]} href="/">Home</a>
          <a class:list={["nav-link", { active: active("/hvac-boot-camp/") }]} href="/hvac-boot-camp/">Boot Camp</a>
          <a class:list={["nav-link", { active: active("/how-it-works/") }]} href="/how-it-works/">How it works</a>
          <a class:list={["nav-link", { active: active("/pricing/") }]} href="/pricing/">Pricing</a>
          <a class:list={["nav-link", { active: active("/try-boot-camp/") }]} href="/try-boot-camp/">Try a lesson</a>
        </nav>

        <div class="header-actions">
          <a class="nav-login" href="https://hvactraining.academy/">Student login</a>
          <a class="nav-cta" href="/pricing/">View pricing</a>
        </div>

        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/">Home</a>
            <a href="/hvac-boot-camp/">HVAC Boot Camp</a>
            <a href="/how-it-works/">How it works</a>
            <a href="/pricing/">Pricing</a>
            <a href="/try-boot-camp/">Try a lesson</a>
            <a href="https://hvactraining.academy/">Student login</a>
          </nav>
        </details>
      </header>
    </div>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <a class="footer-logo" href="/" aria-label="HVAC Training Solutions home">
            <img src="/images/hvac-training-solutions-logo.png" width="250" height="63" alt="HVAC Training Solutions" loading="lazy" />
          </a>
          <p class="footer-note">Straightforward online HVAC training for beginners who want to understand the trade—not just memorize answers.</p>
        </div>
        <div class="footer-column">
          <strong>Explore</strong>
          <a href="/hvac-boot-camp/">HVAC Boot Camp</a>
          <a href="/how-it-works/">How it works</a>
          <a href="/pricing/">Pricing</a>
          <a href="/try-boot-camp/">Try a lesson</a>
        </div>
        <div class="footer-column">
          <strong>Get help</strong>
          <a href="https://www.hvactrainingsolutions.net/find-out-more/">Talk to Ron</a>
          <a href="https://hvactraining.academy/">Student login</a>
          <a href="mailto:hvactrainingsolutions@gmail.com">Email us</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} HVAC Training Solutions</span>
        <span>Development preview — production remains unchanged.</span>
      </div>
    </footer>
  </body>
</html>
