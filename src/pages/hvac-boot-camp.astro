---
import BaseLayout from "../layouts/BaseLayout.astro";

const curriculum = [
  { title: "HVAC foundations", modules: ["Matter, Energy, and Heat Basics","The Refrigeration Process","General Safety Practices","Refrigerant Management","Hand Tools","Tubing and Piping Tools","Specialized HVAC/R Tools"] },
  { title: "Systems, air, and commissioning", modules: ["System Location","Air Distribution Systems","System Connections","Leak Testing","System Evacuation","System Startup and Charging","Testing, Adjusting, and Balancing","Indoor Air Quality"] },
  { title: "Electrical", modules: ["Electricity Fundamentals","Electric Motors","Electric Controls","Wiring Diagrams","Electric Codes","Electrical Troubleshooting"] },
  { title: "Heating, heat pumps, and troubleshooting", modules: ["Mechanical Troubleshooting","Electric Heat","Gas Heat","Oil Heat","Hydronic Heat","Heat Pumps"] },
];
---

<BaseLayout
  title="HVAC Boot Camp | Learn the Fundamentals and Prepare for the Field"
  description="Beginner-friendly online HVAC training with 27 modules, instructor support, job-search preparation, and learning help when a concept does not click."
>
  <div class="bootcamp-page">
    <section class="bc-hero">
      <div class="bc-hero-inner">
        <div>
          <p class="eyebrow">Beginner-friendly online HVAC training</p>
          <h1>Thinking about a career in HVAC? <span>Start here.</span></h1>
          <p class="hero-lead">
            Learn the basic science, tools, and terminology you need to pursue your first entry-level HVAC position.
            Work at your own pace, with help available when a concept doesn’t make sense.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/try-boot-camp/">Try a free lesson</a>
            <a class="button button-secondary" href="/pricing/">View course and pricing</a>
          </div>
          <p class="hero-fineprint">27 modules · Instructor support · Job-search preparation · 30-day satisfaction promise</p>
        </div>

        <aside class="hero-card" aria-label="Who HVAC Boot Camp is for">
          <p class="hero-card-label">Boot Camp may fit you if…</p>
          <ul>
            <li><div><strong>You are new to HVAC</strong><span>The course begins with the science and tools—not assumed experience.</span></div></li>
            <li><div><strong>You need training around work and life</strong><span>Learn online without losing access to a real instructor.</span></div></li>
            <li><div><strong>You want to know why</strong><span>Build reasoning you can use in interviews and in the field.</span></div></li>
            <li><div><strong>You need a path toward employment</strong><span>Prepare your employer search, introduction, OJT plan, and interview.</span></div></li>
          </ul>
          <a class="hero-card-link" href="https://www.hvactrainingsolutions.net/find-out-more/">Not sure? Talk to Ron first →</a>
        </aside>
      </div>
    </section>

    <section class="proof-strip" aria-label="Course facts">
      <div class="proof-grid">
        <div class="proof-item"><strong>27 modules</strong><span>From fundamentals to heat pumps</span></div>
        <div class="proof-item"><strong>Built for beginners</strong><span>No HVAC experience required</span></div>
        <div class="proof-item"><strong>Real support</strong><span>Help when a concept is difficult</span></div>
        <div class="proof-item"><strong>Career preparation</strong><span>Job search, OJT plan, and interview</span></div>
      </div>
    </section>

    <section class="bc-section">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">What you are really building</p>
          <h2>Not a stack of completed videos. A usable technical foundation.</h2>
          <p>The goal is to understand the system well enough to explain what is happening, ask better questions, and keep learning when you enter the field.</p>
        </div>
        <div class="path-grid">
          <article class="path-card"><span class="path-number">1</span><h3>Understand the fundamentals</h3><p>Learn heat, refrigeration, airflow, electricity, tools, safety, systems, and troubleshooting in a deliberate order.</p></article>
          <article class="path-card"><span class="path-number">2</span><h3>Explain what you know</h3><p>Practice the language and reasoning that help you speak intelligently with an interviewer, supervisor, or experienced technician.</p></article>
          <article class="path-card"><span class="path-number">3</span><h3>Enter the field with a plan</h3><p>Prepare an employer search, an introduction, an interview strategy, and a step-by-step OJT plan for hands-on growth.</p></article>
        </div>
      </div>
    </section>

    <section class="bc-section learning-experience-section">
      <div class="section-inner learning-experience-grid">
        <div class="section-heading">
          <p class="eyebrow">Training that responds when you get stuck</p>
          <h2>The lesson stays central. Help appears when you need it.</h2>
          <p>
            The new Boot Camp experience is being designed for a phone: one concept at a time,
            a quick check, and focused learning help instead of a giant chatbot.
          </p>
          <ul class="plain-check-list">
            <li>Explain the current idea more simply</li>
            <li>Connect it to a real HVAC example</li>
            <li>Show why it matters to a technician</li>
            <li>Check your understanding before moving on</li>
          </ul>
          <a class="button button-primary" href="/try-boot-camp/">Try the lesson experience</a>
        </div>

        <div class="learning-preview" aria-label="Example AI-assisted lesson">
          <div class="preview-topline"><span>Unit 1 · Moving heat</span><span>Lesson 1</span></div>
          <div class="preview-progress"><span></span></div>
          <p class="preview-kicker">One idea</p>
          <h3>An air conditioner cools a space by removing heat.</h3>
          <p>Warm indoor air passes the colder evaporator coil. Heat moves from the air into the coil and refrigerant.</p>
          <div class="preview-help">
            <strong>Need another way to see it?</strong>
            <button type="button">Explain it simply</button>
            <button type="button">Give me an HVAC example</button>
            <button type="button">Why does this matter?</button>
          </div>
          <div class="preview-check"><span>Quick check</span><strong>Indoor air is warmer than the coil. Which way does heat move?</strong><span class="preview-answer">Air → coil</span></div>
        </div>
      </div>
    </section>

    <section class="bc-section proof-section">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Proof before promises</p>
          <h2>Students have used the fundamentals where they matter—in the interview.</h2>
          <p>These are real experiences shared by students. They are examples, not employment guarantees.</p>
        </div>

        <div class="student-proof-grid">
          <article class="testimonial-card">
            <p class="testimonial-kicker">Student experience</p>
            <p class="testimonial-text">Robert described discussing the refrigeration cycle, pressures, temperatures, subcooling, and superheat with a prospective employer. He said the employer was impressed with what he had learned and offered him a job.</p>
            <p class="testimonial-name">— Robert O.</p>
          </article>
          <article class="testimonial-card">
            <p class="testimonial-kicker">Student experience</p>
            <p class="testimonial-text">Chris said he could explain the refrigeration cycle in detail during an interview even though his hands-on gauge experience was still limited.</p>
            <p class="testimonial-name">— Chris J.</p>
          </article>
        </div>

        <div class="lesson-grid">
          <div class="lesson-copy">
            <p class="eyebrow">See how Ron teaches</p>
            <h3>A real HVAC lesson—not a polished sales demo.</h3>
            <p>Watch part of Ron's public Basic Refrigeration Cycle lesson and decide whether his teaching style works for you.</p>
            <a class="text-link" href="https://www.youtube.com/watch?v=27uCRQ3B8r4">Open the lesson on YouTube →</a>
          </div>
          <div class="video-frame">
            <iframe src="https://www.youtube-nocookie.com/embed/27uCRQ3B8r4?rel=0" title="Basic Refrigeration Cycle lesson by Ron Walker" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </div>
        <p class="result-disclaimer">Student experiences vary. HVAC Training Solutions does not guarantee employment. Hiring decisions are made by employers.</p>
      </div>
    </section>

    <section class="bc-section alt">
      <div class="section-inner difference-grid">
        <aside class="ron-card">
          <span class="ron-tag">Your instructor</span>
          <h3>Ron Walker</h3>
          <p>Ron entered HVAC after retiring from the U.S. Marines and earning his B.S. He has worked as a technician, service manager, business owner, and trainer.</p>
          <p><strong>His approach:</strong> slow down, understand the principle, and connect it to what a technician actually sees.</p>
          <a href="https://www.hvactrainingsolutions.net/find-out-more/">Schedule a no-pressure conversation →</a>
        </aside>
        <div>
          <div class="section-heading"><p class="eyebrow">Support without hand-holding</p><h2>You should not be left alone with a login.</h2></div>
          <div class="feature-list">
            <div class="feature-row"><span class="feature-icon">01</span><div><h3>A deliberate learning path</h3><p>Concepts build in order so later troubleshooting has a foundation.</p></div></div>
            <div class="feature-row"><span class="feature-icon">02</span><div><h3>Help when something does not click</h3><p>Use focused lesson assistance and reach a real instructor when you need more.</p></div></div>
            <div class="feature-row"><span class="feature-icon">03</span><div><h3>Accountability and progress</h3><p>The objective is understanding and completion—not simply selling access.</p></div></div>
            <div class="feature-row"><span class="feature-icon">04</span><div><h3>Employment preparation</h3><p>Turn technical learning into an employer search, OJT plan, and stronger interview.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="bc-section">
      <div class="section-inner curriculum-intro">
        <div class="section-heading">
          <p class="eyebrow">Course curriculum</p>
          <h2>27 modules. One technical foundation.</h2>
          <p>Move from basic science and tools through airflow, electricity, troubleshooting, heating, and heat pumps.</p>
          <div class="textbook-note"><strong>Textbook:</strong> Residential Construction Academy HVAC, 2nd Edition by Eugene Silberstein. Purchased separately.</div>
        </div>
        <div class="curriculum-groups">
          {curriculum.map((group, index) => (
            <details class="curriculum-group" open={index === 0}>
              <summary>{group.title}</summary>
              <ol class="module-list">{group.modules.map((module) => <li>{module}</li>)}</ol>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bc-section dark" id="pricing">
      <div class="section-inner">
        <div class="section-heading center"><p class="eyebrow">Simple options</p><h2>Choose the pace that fits your budget.</h2><p>Both plans include the complete course, instructor support, career preparation, and the 30-day satisfaction promise.</p></div>
        <div class="pricing-grid">
          <article class="price-card featured">
            <p class="price-label">Best value · Pay in full</p><p class="price">$479</p><p class="price-detail">One payment. Lowest total cost.</p>
            <ul class="price-list"><li>All 27 modules</li><li>Instructor support</li><li>Job-search preparation</li><li>30-day satisfaction promise</li></ul>
            <a class="button button-primary" href="/pricing/">Review pay-in-full option</a>
          </article>
          <article class="price-card">
            <p class="price-label">Spread out the cost</p><p class="price">$97</p><p class="price-detail">$97 to start, then 6 monthly payments. $679 total.</p>
            <ul class="price-list"><li>All 27 modules</li><li>Instructor support</li><li>Job-search preparation</li><li>30-day satisfaction promise</li></ul>
            <a class="button button-dark" href="/pricing/">Review monthly option</a>
          </article>
        </div>
        <p class="pricing-note">The textbook is not included. Current production checkout remains in use until the new PayPal enrollment flow is tested and approved.</p>
      </div>
    </section>

    <section class="bc-section">
      <div class="section-inner">
        <div class="guarantee">
          <div class="guarantee-badge">30 DAY<br />PROMISE</div>
          <div><h2>Make sure the training fits you.</h2><p>Try the course and contact HVAC Training Solutions within 30 days of purchase if it is not the right fit.</p></div>
        </div>
      </div>
    </section>

    <section class="bc-section alt">
      <div class="section-inner fit-grid">
        <div class="fit-card fit-card-positive">
          <p class="eyebrow">A strong fit if…</p>
          <h2>You are ready to study, ask questions, and build from the basics.</h2>
          <ul class="plain-check-list"><li>You are new or early in HVAC</li><li>You want structure and instructor access</li><li>You need online flexibility</li><li>You want career preparation with the technical work</li></ul>
        </div>
        <div class="fit-card">
          <p class="eyebrow">Know before you enroll</p>
          <h2>Online training is the foundation—not a substitute for field experience.</h2>
          <ul class="plain-neutral-list"><li>Employment is not guaranteed</li><li>Hands-on skill grows with an employer or OJT opportunity</li><li>The textbook is purchased separately</li><li>You must make time to study and practice</li></ul>
        </div>
      </div>
    </section>

    <section class="bc-section">
      <div class="section-inner">
        <div class="section-heading center"><p class="eyebrow">Questions before you start</p><h2>Get the uncertainty out of the way.</h2></div>
        <div class="faq-list">
          <details class="faq-item"><summary>I know almost nothing about HVAC. Is that okay?</summary><p>Yes. Boot Camp starts with fundamentals and is intended to build an entry-level technical foundation.</p></details>
          <details class="faq-item"><summary>How do I get hands-on experience?</summary><p>The course includes an OJT/apprenticeship plan to help structure hands-on learning with an employer. Online training cannot replace real field practice.</p></details>
          <details class="faq-item"><summary>Does the course guarantee an HVAC job?</summary><p>No. Employers make hiring decisions. Boot Camp helps you prepare technically and practice the search, introduction, and interview process.</p></details>
          <details class="faq-item"><summary>Can I talk to Ron before I enroll?</summary><p>Yes. Schedule a short, no-pressure conversation to ask questions and see whether the course is a good fit.</p></details>
        </div>
      </div>
    </section>

    <section class="bc-section final-cta">
      <div class="section-inner">
        <p class="eyebrow">See it before you buy it</p>
        <h2>Try the way Boot Camp teaches.</h2>
        <p>Start with a short lesson experience. If it works for you, review the plans and choose your next step.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/try-boot-camp/">Try a lesson</a>
          <a class="button button-secondary" href="/pricing/">See pricing</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
