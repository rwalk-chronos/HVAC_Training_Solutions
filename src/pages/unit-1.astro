---
import BaseLayout from "../layouts/BaseLayout.astro";
const lessons = [
  { title:"Where does the heat go?", kicker:"01 / Heat flow", body:"An air conditioner removes heat from indoor air and carries it outdoors. When 80°F air passes a 45°F evaporator coil, heat moves from the warmer air toward the colder coil.", takeaway:"Heat naturally moves from warmer to cooler.", question:"Indoor air is 80°F and the coil is 45°F. Which way does heat move?", answers:["From the coil into the air","From the air toward the coil"], correct:1, why:"The air is warmer than the coil. Heat moves toward the cooler coil." },
  { title:"Refrigerant changes state", kicker:"02 / Liquid and vapor", body:"Refrigerant is the substance that carries heat. In the indoor evaporator, liquid refrigerant absorbs heat and boils into vapor. In the outdoor condenser, vapor releases heat and becomes liquid again.", takeaway:"It is the same refrigerant; its state changes.", question:"Refrigerant enters as liquid and leaves as vapor. What changed?", answers:["The type of refrigerant","Its state"], correct:1, why:"Liquid and vapor are two states of the same substance." },
  { title:"Temperature and amount of heat", kicker:"03 / How much material?", body:"Temperature tells you how hot or cold something is. A cup and a ten-gallon container of water can both be 80°F. Cooling the larger amount by the same number of degrees requires much more heat removal.", takeaway:"A temperature reading alone does not tell you how much heat must be removed.", question:"A cup and a bucket of water are both 80°F. Which takes more heat removal to reach 60°F?", answers:["The cup","The bucket"], correct:1, why:"The bucket holds more water, even though both begin at the same temperature." },
  { title:"Sensible and latent heat", kicker:"04 / Temperature or state?", body:"Sensible heat changes temperature without a change of state. Latent heat is absorbed or released during a change of state. Water warming from 74°F to 175°F is sensible heating. Water boiling into steam at about 212°F is a latent-heat example at normal atmospheric pressure.", takeaway:"Sensible: temperature changes. Latent: state changes.", question:"Water is boiling into steam while its temperature stays near 212°F. Is heat still being absorbed?", answers:["No, the temperature stopped rising","Yes, heat is changing liquid into vapor"], correct:1, why:"During boiling, added energy turns more liquid into vapor instead of raising the liquid's temperature." },
  { title:"Three ways heat moves", kicker:"05 / Transfer", body:"Conduction moves heat through material or touching surfaces, such as a copper tube wall. Convection carries heat with moving air or liquid, such as air flowing across the evaporator coil. Radiation transfers energy as waves, such as sunlight heating a roof.", takeaway:"At the indoor coil, moving air and metal both play a part.", question:"The blower moves warm air across a colder coil. Which process describes heat carried with moving air?", answers:["Convection","Radiation"], correct:0, why:"Convection involves heat transfer with moving air or liquid." },
  { title:"Pressure sets the boiling temperature", kicker:"06 / Saturation preview", body:"Changing refrigerant pressure changes the temperature at which it boils or condenses. Lower pressure lets it boil at a lower temperature in the evaporator. Higher pressure lets it condense at a higher temperature outdoors.", takeaway:"Technicians use a PT chart to connect refrigerant pressure to its saturation temperature. You will learn to use one later.", question:"Why does the system lower refrigerant pressure in the evaporator?", answers:["So it can boil at a lower temperature","So it becomes a different refrigerant"], correct:0, why:"At lower pressure the refrigerant can boil below the temperature of the indoor air and absorb heat." }
];
---
<BaseLayout title="Unit 1 — How Air Conditioning Moves Heat | HVAC Boot Camp" description="A mobile Unit 1 lesson on heat, state changes, and pressure." indexable={false}>
  <div class="unit-shell" id="unit-app">
    <aside class="unit-top"><a href="/hvac-boot-camp/">← Boot Camp</a><span>UNIT 1 · REVIEW LESSON</span></aside>
    <div class="unit-head"><div><p class="unit-label">HVAC BOOT CAMP</p><h1>How air conditioning moves heat</h1><p>Six short lessons. Choose an answer, read the feedback, then move on.</p></div><div class="unit-counter"><strong id="lesson-count">1 / 6</strong><span>lessons</span></div></div>
    <div class="unit-progress" role="progressbar" aria-label="Lesson progress" aria-valuemin="1" aria-valuemax="6" aria-valuenow="1"><span id="progress-fill"></span></div>
    <nav class="unit-steps" aria-label="Unit lessons">{lessons.map((lesson,i)=><button type="button" data-step={i} aria-label={`Lesson ${i+1}: ${lesson.title}`}>{String(i+1).padStart(2,"0")}</button>)}</nav>
    <article class="unit-card" aria-live="polite">
      <p id="kicker" class="unit-label"></p><h2 id="lesson-title"></h2><p id="lesson-body" class="unit-body"></p>
      <div id="visual" class="unit-visual"></div>
      <div class="unit-takeaway"><span>KEEP THIS</span><p id="takeaway"></p></div>
      <section class="unit-check" aria-labelledby="check-heading"><p class="unit-label">QUICK CHECK</p><h3 id="check-heading"></h3><div id="answers" class="unit-answers"></div><p id="feedback" class="unit-feedback" role="status"></p></section>
      <div class="unit-actions"><button id="prev" type="button" class="unit-back">Previous</button><button id="next" type="button" class="unit-next" disabled>Continue →</button></div>
    </article>
    <section id="finish" class="unit-finish" hidden><h2>Put it together</h2><p>Warm indoor air passes a colder coil. Heat moves into low-pressure refrigerant, which boils from liquid into vapor. The system carries that heat outdoors.</p><p><strong>Say it in your own words:</strong> An air conditioner does not make cold. It moves heat.</p><a href="https://www.youtube.com/watch?v=27uCRQ3B8r4" target="_blank" rel="noopener noreferrer">Watch Ron's Basic Refrigeration Cycle lesson ↗</a></section>
    <p class="unit-note">Review build: the specific uploaded Unit 1 videos and PT chart image are awaiting asset placement. This lesson does not claim that answers are saved.</p>
  </div>
</BaseLayout>
<script define:vars={{lessons}}>
  let current=0; const answered=new Set();
  const $=id=>document.getElementById(id);
  function visual(i){
    if(i===3) return `<div class="heat-demo" aria-label="Water warming and boiling demonstration"><div class="heat-stage"><span>1 · START</span><strong>74°F</strong><small>Water heats</small></div><div class="heat-stage"><span>2 · WARMING</span><strong>175°F</strong><small>Temperature rises</small></div><div class="heat-stage"><span>3 · BOILING</span><strong>212°F</strong><small>Liquid becomes vapor</small></div><div class="heat-stage hot"><span>4 · MORE HEAT</span><strong>≈212°F</strong><small>More steam, similar water temperature</small></div></div><p class="visual-caption">Illustration at normal atmospheric pressure. The burner can deliver more heat during boiling; its 550°F and 1,000°F settings are illustrative, not water temperatures.</p>`;
    if(i===5) return `<div class="pressure-demo"><div><span>LOW PRESSURE · INDOORS</span><strong>Lower boiling temperature</strong><small>Refrigerant absorbs heat</small></div><div><span>HIGH PRESSURE · OUTDOORS</span><strong>Higher condensing temperature</strong><small>Refrigerant releases heat</small></div></div>`;
    if(i===0) return `<div class="flow-demo"><div><strong>80°F</strong><span>Indoor air</span></div><b aria-hidden="true">→ HEAT →</b><div><strong>45°F</strong><span>Evaporator coil</span></div></div>`;
    return "";
  }
  function render(){const l=lessons[current];$('lesson-count').textContent=`${current+1} / 6`; $('progress-fill').style.width=`${(current+1)/6*100}%`;document.querySelector('.unit-progress').setAttribute('aria-valuenow',current+1);$('kicker').textContent=l.kicker;$('lesson-title').textContent=l.title;$('lesson-body').textContent=l.body;$('takeaway').textContent=l.takeaway;$('check-heading').textContent=l.question;$('visual').innerHTML=visual(current);$('visual').hidden=!visual(current);$('feedback').textContent='';$('feedback').className='unit-feedback';$('answers').replaceChildren();l.answers.forEach((answer,i)=>{const button=document.createElement('button');button.type='button';button.textContent=answer;button.addEventListener('click',()=>choose(i));$('answers').append(button)});$('prev').disabled=current===0;$('next').disabled=!answered.has(current);$('next').textContent=current===5?'Finish unit →':'Continue →';document.querySelectorAll('[data-step]').forEach((b,i)=>{b.classList.toggle('active',i===current);b.classList.toggle('done',answered.has(i));b.setAttribute('aria-current',i===current?'step':'false')});if(answered.has(current)) $('next').disabled=false;}
  function choose(i){const l=lessons[current],correct=i===l.correct;const buttons=[...$('answers').children];buttons.forEach((b,n)=>{b.classList.toggle('correct',n===l.correct);b.classList.toggle('wrong',n===i&&!correct)});$('feedback').textContent=(correct?'Correct. ':'Try again. ')+l.why;$('feedback').classList.toggle('good',correct);if(correct){answered.add(current);$('next').disabled=false;document.querySelector(`[data-step="${current}"]`).classList.add('done')}}
  $('prev').addEventListener('click',()=>{if(current>0){current--;render()}});$('next').addEventListener('click',()=>{if(current<5){current++;render();document.querySelector('.unit-card').scrollIntoView({behavior:'smooth',block:'start'})}else{$('finish').hidden=false;$('finish').scrollIntoView({behavior:'smooth'})}});document.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>{current=Number(b.dataset.step);render()}));render();
</script>
