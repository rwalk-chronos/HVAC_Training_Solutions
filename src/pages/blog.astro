---
import BaseLayout from "../layouts/BaseLayout.astro";
import articles from "../data/legacy-articles.json";
import "../styles/article.css";

const guides = articles
  .filter((article) => article.gsc.clicks > 0 || article.gsc.impressions >= 100)
  .sort((a, b) => b.gsc.clicks - a.gsc.clicks || b.gsc.impressions - a.gsc.impressions || a.title.localeCompare(b.title));
---

<BaseLayout title="HVAC Training Articles | HVAC Training Solutions" description="Browse preserved HVAC technical articles from Ron Walker covering refrigerants, refrigeration, electrical systems, airflow, troubleshooting, and more.">
  <div class="support-page archive-article">
    <section class="archive-article-header"><div class="archive-article-shell">
      <nav aria-label="Breadcrumb" class="archive-breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/resources/">Resources</a><span aria-hidden="true">/</span><span>Articles</span></nav>
      <p class="archive-category">Technical article library</p><h1>Explore HVAC field topics.</h1>
      <p class="archive-byline">Browse Ron’s preserved articles. Older articles are marked as archived; confirm current equipment instructions and requirements before field work.</p>
    </div></section>
    <section class="archive-article-shell archive-library" aria-label="HVAC articles">
      <p class="archive-library-intro">{guides.length} technical articles with recent search interest. Search titles and topics below.</p>
      <label for="archive-search">Find an article</label>
      <input id="archive-search" type="search" placeholder="Try airflow, TXV, superheat, refrigeration…" autocomplete="off" />
      <p class="archive-search-count" aria-live="polite"></p>
      <div class="archive-library-grid" id="archive-results">
        {guides.map((article) => (
          <article class="archive-library-card" data-search={`${article.title} ${article.category} ${article.description}`.toLowerCase()}>
            <p class="archive-category">{article.category}</p>
            <h2><a href={article.path}>{article.title}</a></h2>
            <p>{article.description}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script>
    const search = document.querySelector<HTMLInputElement>("#archive-search");
    const cards = [...document.querySelectorAll<HTMLElement>(".archive-library-card")];
    const count = document.querySelector<HTMLElement>(".archive-search-count");
    search?.addEventListener("input", () => {
      const term = search.value.toLowerCase().trim();
      let matches = 0;
      for (const card of cards) {
        const visible = !term || (card.dataset.search || "").includes(term);
        card.hidden = !visible;
        if (visible) matches++;
      }
      if (count) count.textContent = term ? `${matches} article${matches === 1 ? "" : "s"} found` : "";
    });
  </script>
</BaseLayout>
