---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="HVAC Technician Course Archive | HVAC Training Solutions"
  description="Information about a previous HVAC Technician Course and the current HVAC Boot Camp enrollment option."
  indexable={false}
>
  <div class="standard-page">
    <section class="page-hero"><div class="page-hero-inner narrow-hero">
      <p class="eyebrow">Previous course page</p>
      <h1>Looking for the HVAC Technician Course?</h1>
      <p>This address previously described a separate 20-module course. Its enrollment details have not been confirmed for the new site.</p>
    </div></section>
    <section class="page-section"><div class="page-shell narrow-hero">
      <div class="section-heading">
        <h2>See the course currently offered on this site.</h2>
        <p>The existing HVAC Boot Camp is a 27-module course delivered through Moodle. Review the curriculum and price before choosing it; it is a different course from the one described at this address.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/hvac-boot-camp/">Explore HVAC Boot Camp</a>
          <a class="button button-outline-dark" href="/contact/">Ask about the previous course</a>
        </div>
      </div>
    </div></section>
  </div>
</BaseLayout>
