---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const {
  title,
  description,
  indexable = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? "index,follow" : "noindex,nofollow"}
    />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">HVAC Training Solutions</a>
      <nav aria-label="Primary navigation">
        <a href="/hvac-boot-camp/">HVAC Boot Camp</a>
        <a href="https://hvactraining.academy/">Student Login</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>HVAC Training Solutions</p>
    </footer>
  </body>
</html>
