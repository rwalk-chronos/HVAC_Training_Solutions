---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08111f" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="HVAC Training Solutions home">
        <span class="brand-mark" aria-hidden="true">HTS</span>
        <span class="brand-copy"><strong>HVAC Training</strong><span>Solutions</span></span>
      </a>
      <nav aria-label="Primary navigation">
        <a class:list={["nav-link", { active: path.startsWith("/hvac-boot-camp") }]} href="/hvac-boot-camp/">HVAC Boot Camp</a>
        <a class="nav-link" href="https://www.hvactrainingsolutions.net/find-out-more/">Talk to Ron</a>
        <a class="student-link" href="https://hvactraining.academy/">Student Login</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <a class="brand footer-brand" href="/">
            <span class="brand-mark" aria-hidden="true">HTS</span>
            <span class="brand-copy"><strong>HVAC Training</strong><span>Solutions</span></span>
          </a>
          <p class="footer-note">Practical online HVAC training built around understanding the trade, not memorizing answers.</p>
        </div>
        <div class="footer-links">
          <a href="/hvac-boot-camp/">HVAC Boot Camp</a>
          <a href="https://www.hvactrainingsolutions.net/find-out-more/">Talk to Ron</a>
          <a href="https://hvactraining.academy/">Student Login</a>
          <a href="mailto:hvactrainingsolutions@gmail.com">Email us</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>HVAC Training Solutions</span>
        <span>Rebuild preview — not yet the production website.</span>
      </div>
    </footer>
  </body>
</html>
